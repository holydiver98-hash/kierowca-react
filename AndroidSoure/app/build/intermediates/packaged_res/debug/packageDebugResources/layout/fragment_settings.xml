<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/graphite_dark"
    tools:context=".screens.SettingsFragment">

    <TextView
        android:id="@+id/txtDataRelevance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/txtLanguageLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/language_label"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"/>

    <Spinner
        android:id="@+id/spinnerLanguage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <!-- Map Settings -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/map_settings_label"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchRedArrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/pref_show_red_arrow"
        android:textColor="@color/text_primary"
        android:checked="true"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/pref_highlight_label"
        android:textSize="16sp"
        android:textColor="@color/text_primary"/>

    <RadioGroup
        android:id="@+id/radioGroupHighlight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <RadioButton
            android:id="@+id/radioHighlightSimple"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pref_highlight_simple"
            android:textColor="@color/text_secondary"/>

        <RadioButton
            android:id="@+id/radioHighlightSmart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pref_highlight_smart"
            android:textColor="@color/text_secondary"/>

        <RadioButton
            android:id="@+id/radioHighlightNone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pref_highlight_none"
            android:textColor="@color/text_secondary"/>
    </RadioGroup>

    <Button
        android:id="@+id/btnShowLogs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_show_logs"
        android:backgroundTint="@color/graphite_accent"
        android:textColor="@color/black"
        android:layout_marginTop="16dp"/>
        
    <Button
        android:id="@+id/btnRestore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_restore"
        android:visibility="gone"
        tools:visibility="visible"
        android:backgroundTint="@color/graphite_accent"
        android:textColor="@color/black"
        android:layout_marginTop="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/agencies_label"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAgencies"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_rounded_card"
        android:padding="4dp"/>

</LinearLayout>
